{
  "schema_version": "blasst-veto-row-v1",
  "metadata_dtype": [
    [
      "sample_id",
      "<U64"
    ],
    [
      "request_id",
      "<U64"
    ],
    [
      "seed",
      "<i8"
    ],
    [
      "sequence_length",
      "<i4"
    ],
    [
      "diffusion_block",
      "<i2"
    ],
    [
      "denoising_step",
      "<i2"
    ],
    [
      "remaining_mask_ratio",
      "<f4"
    ],
    [
      "noise_bucket",
      "<U8"
    ],
    [
      "layer",
      "<i2"
    ],
    [
      "head",
      "<i2"
    ],
    [
      "query_tile",
      "<i4"
    ],
    [
      "kv_tile",
      "<i4"
    ],
    [
      "traversal_index",
      "<i4"
    ],
    [
      "valid_query_rows",
      "<i2"
    ],
    [
      "threshold",
      "<f4"
    ],
    [
      "exact_blasst_skip",
      "|u1"
    ],
    [
      "introduced_new_max",
      "|u1"
    ],
    [
      "v_mean_row_norm",
      "<f4"
    ],
    [
      "v_max_row_norm",
      "<f4"
    ],
    [
      "v_frobenius_per_sqrt_rows",
      "<f4"
    ],
    [
      "v_centroid_norm",
      "<f4"
    ],
    [
      "v_residual_max_norm",
      "<f4"
    ],
    [
      "v_per_dimension_variance",
      "<f4"
    ]
  ],
  "row_float_fields": [
    "row_score",
    "row_log_score",
    "row_local_max",
    "row_running_max_before",
    "row_running_sum_before",
    "row_local_logsumexp",
    "row_final_logsumexp",
    "row_final_output_norm",
    "row_local_value_norm",
    "row_centroid_error_norm",
    "row_query_delta"
  ],
  "row_uint8_fields": [
    "row_keep_vote",
    "row_token_state"
  ],
  "token_states": {
    "0": "masked",
    "1": "newly_revealed",
    "2": "previously_revealed",
    "3": "stable_visible",
    "4": "prefix"
  },
  "q_block_size": 128,
  "kv_block_size": 64,
  "sample_fraction": 0.005,
  "query_tiles_per_sample": 1,
  "row_storage": "float16",
  "stable_query_delta": 0.05,
  "sampling_unit": "sample_id+query_tile+kv_tile shared across steps/layers/heads"
}
